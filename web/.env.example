# Next server -> BFF access. The browser now always talks to the Next app's own /api routes,
# and the Next app proxies authenticated requests to the BFF.
BFF_BASE_URL=http://127.0.0.1:9000

# NEXT_PUBLIC_BFF_BASE_URL is still accepted as a fallback by the server-side proxy
# for compatibility with older local setups, but the browser no longer uses it directly.
