# 复制本文件为 deploy.env 后再改值。
# 生成命令：python deploy/k8s/generate.py --env-file deploy/k8s/deploy.env

APP_NAME=teleai-safety
NAMESPACE=teleai
DOMAIN=teleai.example.com
INGRESS_CLASS=nginx
ENABLE_TLS=true
TLS_SECRET_NAME=teleai-tls

# 镜像
PYTHON_SERVICES_IMAGE=registry.example.com/team/teleai-python-services:latest
WEB_IMAGE=registry.example.com/team/teleai-web:latest
# 如需分开镜像，可单独覆盖
# BFF_IMAGE=
# ORCH_IMAGE=

# 副本数（当前建议 bff / orchestrator 保持 1）
WEB_REPLICAS=1
BFF_REPLICAS=1
ORCH_REPLICAS=1

# 存储
STORAGE_CLASS=
DATA_STORAGE_SIZE=100Gi
BENCHMARK_STORAGE_SIZE=100Gi
EVALUATE_STORAGE_SIZE=100Gi

# 基础运行配置
TELEAI_TZ=Asia/Shanghai
BFF_CORS_ALLOW_ORIGINS=https://teleai.example.com
NEXT_PUBLIC_BFF_BASE_URL=
ORCHESTRATOR_BASE_URL=http://telert-orchestrator:9001
BFF_HTTP_TIMEOUT=20
BFF_MANAGED_MODE_MAX_ACTIVE_RUNS_GLOBAL=6
BFF_MANAGED_MODE_MAX_ACTIVE_RUNS_PER_IP=2
BFF_MANAGED_MODE_MIN_INTERVAL_SECONDS=300
BFF_MANAGED_MODE_ACCESS_CONTROL_ENABLED=false
BFF_MANAGED_MODE_IP_WHITELIST=127.0.0.1,::1

# 内部模型 / 托管模式（按需填写）
TELEAI_INTERNAL_LLM_BASE_URL=
TELEAI_INTERNAL_LLM_MODEL=gpt-4o-mini
TELEAI_USE_INTERNAL_LLM_FOR_ATTACK=true
TELEAI_USE_INTERNAL_LLM_FOR_EVALUATE=true
TELEAI_STRICT_CRED_ISOLATION=true

# Secret 项（为空也能生成，但线上建议填写）
TELEAI_INTERNAL_LLM_API_KEY=
BFF_MANAGED_MODE_INVITE_CODES=
# JSON 字符串，示例：[{"id":"gpt-4o-mini","label":"GPT-4o-mini","target_model_name":"gpt-4o-mini","base_url":"https://.../v1","api_key":"***"}]
TELEAI_MANAGED_TARGET_MODELS=
