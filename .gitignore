*.py[cod]
*.pyo
*.pyd
*.so
*.dll
*.dist-info/
*.egg-info/
.eggs/
*.egg

# Build outputs
build/
dist/
*.whl

# Virtual environments and local Python settings
.venv/
venv/
env/
.env
.env.*
.envrc
.secrets/
secrets.*

